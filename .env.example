# Copia este archivo a .env y completa con los valores reales.
# .env es ignorado por git y NUNCA debe commitearse.

# Credenciales de base de datos (perfil dev)
DB_USER=root
DB_PASSWORD=root

# Secreto JWT (256 bits / 64 hex). Generar uno propio con:
#   openssl rand -hex 32
JWT_SECRET=changeme-genera-tu-propio-secreto
